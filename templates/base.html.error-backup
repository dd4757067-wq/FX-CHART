<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#07141b"><title>{% block title %}FX CHART{% endblock %}</title><link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet"><link rel="stylesheet" href="{{url_for('static',filename='css/app.css')}}">{% block head %}{% endblock %}</head><body><div class="fx-grid"></div><div class="fx-candles">{% for x in range(18) %}<i style="--x:{{x*6}}%;--h:{{60+(x%6)*25}}px;--d:{{(x%5)*.4}}s"></i>{% endfor %}</div><header class="topbar"><a class="brand" href="{{url_for('home') if 'home' in current_app.view_functions else url_for('index')}}"><span class="brand-logo"><img src="{{url_for('static',filename='images/dfx-logo.jpg')}}" alt="DFX"></span><span><b>FX</b> CHART<small>PRO • TRAINING • EDUCATION • MARKET ANALYSIS</small></span></a><nav class="mainnav"><a class="home-link" href="{{url_for('home') if 'home' in current_app.view_functions else url_for('index')}}">Home</a><a href="{{url_for('chart')}}">Chart</a><a href="{{url_for('learning')}}">Learning</a><a href="{{url_for('community')}}">Community</a><a href="{{url_for('news')}}">News</a>{% if session.get('user_id') %}<a href="{{url_for('dashboard')}}">Dashboard</a>{% endif %}</nav><div>{% if session.get('user_id') %}<a class="avatar-mini" href="{{url_for('profile')}}">{% if session.get('photo') %}<img src="{{session.get('photo')}}" alt="Profile">{% else %}{{(session.get('full_name') or 'U')[0]|upper}}{% endif %}</a>{% else %}<a class="btn btn-primary" href="{{url_for('login')}}">Login</a>{% endif %}</div></header><div class="page-tools"><button class="tool-btn" onclick="fxBack()">← Back</button><a class="tool-btn" href="{{url_for('home') if 'home' in current_app.view_functions else url_for('index')}}">⌂ Home</a></div><main class="wrap">{% with msgs=get_flashed_messages(with_categories=true) %}{% for cat,msg in msgs %}<div class="flash {{cat}}">{{msg}}</div>{% endfor %}{% endwith %}{% block content %}{% endblock %}</main><button class="help-fab" onclick="toggleHelp()">?</button><div class="help-panel" id="helpPanel"><div class="help-head"><b>FX CHART HELP</b><button onclick="toggleHelp()">×</button></div><div class="help-sub">Ask about candles, patterns, SMC, MTF, risk, chart, profile, news or the website.</div><div id="helpLog" class="help-log"><div class="help-msg">Hello. Ask your trading or website question.</div></div><div class="help-row"><input id="helpInput" placeholder="Type your question..." onkeydown="if(event.key==='Enter')askHelp()"><button onclick="askHelp()">Ask</button></div></div><script src="{{url_for('static',filename='js/app.js')}}"></script>{% block scripts %}{% endblock %}</body></html>
