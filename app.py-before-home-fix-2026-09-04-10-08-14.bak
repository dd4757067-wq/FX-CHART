@app.route("/api/help", methods=["POST"])
def help_api():
    q=request.json.get("message","").lower()
    answers=[
      (("profile","bio","photo","social","avatar"),"Profile → Edit Profile থেকে photo, bio, experience, strategy, hobbies, education, goals এবং social accounts যোগ করতে পারবে. Photo না এলে JPG/PNG/WEBP এবং 5MB-এর মধ্যে রাখো."),
      (("learning","course","lesson","candle","candlestick","pattern","support","resistance","smc","mtf","timeframe"),"Learning Center-এ Beginner → Advanced roadmap, Candlestick & Chart Reference, Technical Analysis, SMC, Risk Management এবং Multi-Timeframe Analysis আছে. Reference পেজ থেকে copy ও A4 print করা যায়."),
      (("broker","binance","mt5","exness","xm"),"Brokers পেজে broker account profile save করা যায়. আসল order execution/API চালাতে broker-এর official API credentials, permissions এবং secure server integration দরকার."),
      (("chart","live","candle","market","forex","stock","crypto","gold","index"),"Chart পেজে Forex, Stocks, Crypto, Indices ও Commodities-এর preset symbols এবং 1m থেকে 1M পর্যন্ত timeframe দেওয়া আছে. Fullscreen দিয়ে বড় করে chart দেখা যায়."),
      (("subscription","subscribe","premium","pro"),"Subscriptions পেজ থেকে plan request করা যায়. Real payment চালু করতে payment gateway credentials/API এবং server-side verification প্রয়োজন."),
      (("analytics","analysis","win rate","pnl"),"Analytics তোমার Journal-এর recorded trades থেকে total trades, win rate, P/L এবং average P/L দেখায়."),
      (("news","calendar","high impact","medium impact","low impact","nfp","fomc","cpi"),"News পেজে TradingView Top Stories এবং Economic Calendar রাখা হয়েছে. Calendar-এ country, period, importance ও category অনুযায়ী filter করা যায়."),
      (("community","post","comment","like"),"Community-তে professional feed, market/topic filters, posts, likes, comments এবং learning-post publishing access আছে."),
      (("theme","dark","soft","appearance","settings"),"Profile-এর 3-dot menu বা Settings থেকে Soft, Pro, Midnight এবং Ocean theme বেছে নিতে পারবে. পছন্দটি browser-এ save থাকবে."),
    ]
    for keys,ans in answers:
        if any(k in q for k in keys): return jsonify({"answer":ans})
    return jsonify({"answer":"আমি FX CHART Help Assistant. Chart, Market, Timeframe, Learning, Candles, Patterns, SMC, MTF, Risk, Profile, Community, News, Calendar, Broker, Subscription, Journal বা Analytics নিয়ে প্রশ্ন করো."})

@app.get("/health")
def health():
    return jsonify({"status":"ok","app":"FX CHART","db":os.path.exists(DB)})

@app.errorhandler(413)
def too_large(e):
    flash("Image/file is too large. Maximum 5MB.","warning")
    return redirect(url_for("profile"))

init_db()

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=int(os.environ.get("PORT",5000)), debug=False)
